@page "/SfUploaderwithProgressBarOne"
@using Syncfusion.Blazor.Inputs
@using Microsoft.AspNetCore.Components.Forms
@inject IWebHostEnvironment Env
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Buttons
@using Microsoft.AspNetCore.Components.Web

<h3>Upload Large File (No Controller)</h3>

<SfUploader AutoUpload="true" MaxFileSize="104857600">
    <UploaderEvents ValueChange="@OnChange" Progressing="@OnProgressing" BeforeUpload="@OnBeforeUpload"></UploaderEvents>
</SfUploader>

<SfDialog @ref="UploadDialog" Width="400px" IsModal="true" ShowCloseIcon="true"
Visible="@IsDialogVisible" Header="File Upload">
    <DialogTemplates>
        <Content>
            @UploadProgressStatus
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private SfUploader Uploader;
    private SfDialog UploadDialog;
    private bool IsDialogVisible = false;
    private string UploadProgressStatus = "";

    private void OnBeforeUpload(BeforeUploadEventArgs args) 
    { IsDialogVisible = true; StateHasChanged(); }

    private void OnProgressing(Syncfusion.Blazor.Inputs.ProgressEventArgs args)
    {
        UploadProgressStatus = $"Uploading: {args.Loaded / 1048576M:F2} MB of {args.Total / 1048576M:F2} MB";
    }

    private async Task OnChange(UploadChangeEventArgs args)
    {     
        try
        {
            var uploadFolder = Path.Combine(Env.WebRootPath, "Upload");
            if (!Directory.Exists(uploadFolder))
                Directory.CreateDirectory(uploadFolder);

            foreach (var file in args.Files)
            {
                var filePath = Path.Combine(uploadFolder, file.FileInfo.Name);

                // Save in chunks to reduce memory pressure
                using var outputStream = new FileStream(filePath, FileMode.Create, FileAccess.Write);

                var inputStream = file.File.OpenReadStream(long.MaxValue);
                var buffer = new byte[524288];
                int bytesRead;

                while ((bytesRead = await inputStream.ReadAsync(buffer, 0, buffer.Length)) > 0)
                {
                    await outputStream.WriteAsync(buffer.AsMemory(0, bytesRead));
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Upload failed: {ex.Message}");
        }

        IsDialogVisible = false;
    }



}